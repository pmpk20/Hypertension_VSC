.Rproj.user
.Rhistory
.RData
.Ruserdata
.claude/
.superpowers/

# Word lock files
~$*

# Raw vendor extracts and large binaries. The ten country response
# spreadsheets in Data/SurveyData/ are the analysis inputs and are tracked.
Data/**/*.sav
Data/**/*.zip
Data/**/*.xlsx
!Data/SurveyData/*.xlsx

# Pipeline intermediates written by Scripts/Setup/ (large and regenerated).
# This folder can also hold respondent identifier mappings, which must never
# be committed.
Data/Intermediate/

# Analysis files rebuilt by script 13 or kept as local working copies.
Data/Data_AllCountries_SubsampledForAnalysis.csv
Data/Data_AllCountries_SubsampledForAnalysis_Rebuilt.csv
Output/Tables/Baseline_AnalysisFile_PreIncomeFix.rds
Output/Tables/PreIncomeFix_Snapshot/

# Data-preparation diagnostic plots regenerated by setup scripts 05-11.
Output/Figures/Hypertension_Diagnostic_*.png

# Release run records; other local diagnostics remain untracked.
Output/Replication/*
!Output/Replication/Replication_Run.log
!Output/Replication/Session_Info.txt
!Output/Replication/Step_Timings.csv
!Output/Replication/Input_Checksums.csv
!Output/Replication/Environment_Check.csv
!Output/Replication/Code_Checksums.csv
!Output/Replication/README.md

# Local validation copies and package libraries.
scratchpad_tmp/
renv/library/
renv/staging/
renv/.gitignore

# Local-only internal documentation and manuscripts.
/docs/
/Papers/
/handoffs/
